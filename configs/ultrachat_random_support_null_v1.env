# Random-support module null for the UltraChat continuous intervention study.
# This keeps the target/reference pairs, candidate pool, splits, training and
# downstream contract fixed. Only module support selection is randomized.

BASE_CONFIG_FILE=configs/ultrachat_ablation_small_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_random_support_null_v1
TASK_LABEL=ultrachat_random_support_null_v1

# Freeze the random-support null. The same support and random loadings are used
# for every epoch, and are not selected by downstream behavior.
MODULE_DIRECTION_MODE=random_support
RANDOM_SUPPORT_SEED=${RANDOM_SUPPORT_SEED:-777}
SUPPORTS="128"
NUM_MODULES=8
MAX_SELECTED_MODULES=6
MAX_PER_SUPPORT=6
ALL_HELDOUT_MODULES=0
RANDOM_SUPPORT_NULL=1

# The null uses the same pipeline as the reference ablation.
CONTINUOUS_CONTROLS="opposite_direction random_hidden_direction"
REFINED_CODE_DOSE_MATCH_CONTROLS=1
RANDOM_HIDDEN_CANDIDATES=8
