source configs/beavertails_external_semantic_continuous_m4_long_v2.env
source configs/strict_chain_common_v2.env

EXPERIMENT_PROFILE=beavertails_strict_chain_main_v2
TASK_LABEL=beavertails_strict_chain_main_v2
# The deduplicated 330k source contains 16,140 unique prompts. A 50/20/30
# train/selection/evaluation split leaves 4,842 evaluation prompts, enough for
# the explicit 10/25/40/25 downstream role allocation.
TARGET_PROMPT_MAX_SAMPLES=16140
VAL_RATIO=0.20
TEST_RATIO=0.30
BASELINE_MAX_SAMPLES=1800
EXTRACTION_MAX_LENGTH=2048
EXTERNAL_SEMANTIC_MAX_LENGTH=2048
DOWNSTREAM_MAX_LENGTH=2048
METRIC_PROFILE=safety
ANSWER_EXTRACTION=none
