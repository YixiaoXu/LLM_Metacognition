# UltraChat ablation suite for Fig. 5a-5c and Fig. 6a-6d.
# The model-scale panel (Fig. 5d) is supplied by the separate scale run.

BASE_CONFIG_FILE=configs/ultrachat_external_semantic_continuous_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_ablation_small_v1
TASK_LABEL=ultrachat_ablation_small_v1

# Fixed target models with several small external semantic references.
# The first target is used for the primary reference-model ablation (5a).
# Qwen3-4B is retained as the established reference condition, not repeated
# as a target in this suite.
PAIR_SPECS="llama32_3b:qwen3_0p6b:14 llama32_3b:qwen3_1p7b:14 llama32_3b:gemma3_1b_it:14 llama32_3b:qwen3_4b:16"

TARGET_PROMPT_MAX_SAMPLES=10000
GENERATION_RECORD_STEPS="0,4,8,12,16,20"
MAX_GENERATION_STEPS=21
EXTRACTION_MAX_LENGTH=2048
EXTERNAL_SEMANTIC_MAX_LENGTH=2048
EXTRACTION_SHARD_SIZE=2048
MEMORY_EFFICIENT_EXTRACTION=1
CHAT_TEMPLATE_ENABLE_THINKING=auto

# Fixed module discovery contract across all ablation conditions.
SUPPORTS="128"
CANDIDATE_TOP_K=1024
NUM_MODULES=8
MAX_SELECTED_MODULES=6
MAX_PER_SUPPORT=6
# Downstream continuation exports every module passing the held-out gate.
ALL_HELDOUT_MODULES=1

# Training and probe settings are unchanged across conditions.
TRAIN_BATCH_SIZE=512
ENCODE_BATCH_SIZE=1024
TARGET_EXTRACTION_BATCH_SIZE=4
SEMANTIC_EXTRACTION_BATCH_SIZE=8
GENERATION_BATCH_SIZE=4
MAIN_EPOCHS=120
MAIN_DIRECTION_FREEZE=65
MAIN_CHECKPOINT_START=65
SEMANTIC_ENCODER_WARMUP_EPOCHS=30
SEMANTIC_PROBE_EPOCHS=30
MODULE_REFINER_EPOCHS=80

# Same long-generation and critical-sample contract used in the main study.
BASELINE_MAX_SAMPLES=1200
BASELINE_MAX_NEW_TOKENS=2048
GENERATION_MAX_NEW_TOKENS=2048
DOWNSTREAM_MAX_LENGTH=2048
GENERATION_PATCH_STEPS=32
PERSISTENT_MAX_TRUNCATED_RATE=1.0
PERSISTENT_POPULATION=critical
PERSISTENT_EVALUATION_ROLE=trajectory_confirmatory

# 5b: next-token (one-step) versus persistent generation is produced by the
# same downstream run on the same module and held-out population.
# 5c/6d: add a norm- and dose-matched random code direction.
CONTINUOUS_CONTROLS="opposite_direction random_direction"
REFINED_CODE_DOSE_MATCH_CONTROLS=1
REFINED_CODE_RANDOM_DIRECTION_MODE=empirical_pca

CONTINUOUS_DOSES="0.25 0.5 1.0"
CONTINUOUS_DIRECTION=0:1
MAX_HIDDEN_REL_NORM=0.03
MAX_SEMANTIC_REL_DELTA=0.05
DIRECT_TRUST_REGION_STEPS=20
DIRECT_TRUST_REGION_STEP_SCALE=1.25
DIRECT_TRUST_REGION_HIDDEN_PENALTY=0.10

METRIC_PROFILE=conversation
ANSWER_EXTRACTION=none
DOWNSTREAM_USE_CHAT_TEMPLATE=0
TRUST_REMOTE_CODE=1
