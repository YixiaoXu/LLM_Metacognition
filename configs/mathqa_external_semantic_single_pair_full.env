# Single-pair full downstream validation.  The base configuration supplies the
# model paths and shared scientific defaults; this file only narrows the run.
source configs/mathqa_external_semantic_continuous_v1.env

EXPERIMENT_PROFILE=mathqa_external_semantic_single_pair_full
PAIR_SPECS="qwen3_4b:llama31_8b:16"
TARGET_PROMPT_MAX_SAMPLES=256
GENERATION_RECORD_STEPS="0,4,8,12,16,20"

SUPPORTS="4"
CANDIDATE_TOP_K=256
NUM_MODULES=4
MAX_SELECTED_MODULES=1
MAX_PER_SUPPORT=1

# Keep the complete training and direct-intervention path, while limiting only
# the number of exported modules and the cached prompt population.
MAIN_EPOCHS=100
MODULE_REFINER_EPOCHS=80

ASSOCIATION_EVALUATION_ROLE=all
BASELINE_MAX_SAMPLES=0
BASELINE_MAX_NEW_TOKENS=2048
GENERATION_MAX_NEW_TOKENS=2048
PERSISTENT_MAX_TRUNCATED_RATE=1.0
GENERATION_PATCH_STEPS=32
CONTINUOUS_DOSES="0.25 0.5 1.0"
INTERVENTION_BOOTSTRAP_SAMPLES=300
INTERVENTION_PERMUTATION_TESTS=300
CRITICAL_MAX_SAMPLES=32

# The current MathQA downstream contract uses the natural prompt without an
# extra chat wrapper, matching the generated-step activation cache.
DOWNSTREAM_USE_CHAT_TEMPLATE=0
METRIC_PROFILE=math
ANSWER_EXTRACTION=mathqa_choice
