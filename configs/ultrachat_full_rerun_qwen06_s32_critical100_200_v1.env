# UltraChat rerun with a larger critical held-out population.
# Reuse the existing upstream artifacts; only the critical trajectory population
# is widened for the confirmatory intervention analysis.
BASE_CONFIG_FILE=configs/ultrachat_full_rerun_qwen06_s32_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_full_rerun_qwen06_s32_critical100_200_v1
CRITICAL_FRACTIONS="0.30 0.40 0.50"
CRITICAL_MAX_SAMPLES=192
PERSISTENT_POPULATION=critical
TASK_LABEL=ultrachat_full_rerun_qwen06_s32_critical100_200_v1
