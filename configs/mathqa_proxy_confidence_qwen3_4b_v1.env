# Confirmatory MathQA monitoring experiment.  Qwen3-4B is large enough to
# solve a meaningful subset of MathQA without approaching ceiling accuracy;
# Llama-3.1-8B supplies a different-family external semantic reference.
BASE_CONFIG_FILE=configs/mathqa_external_semantic_continuous_m8_long_v2.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=mathqa_proxy_confidence_qwen3_4b_v1
PAIR_SPECS="qwen3_4b:llama31_8b:16"

# Keep the established generated-step and decoupling contract.
TARGET_PROMPT_MAX_SAMPLES=8000
GENERATION_RECORD_STEPS="0,4,8,12,16,20"
SUPPORTS="128"
NUM_MODULES=8
MAX_SELECTED_MODULES=4
MAX_PER_SUPPORT=4

# A larger independent association set improves calibration precision. Full
# trajectories remain restricted to critical held-out examples.
ASSOCIATION_EVALUATION_ROLE=association_confirmatory
BASELINE_MAX_SAMPLES=2000
BASELINE_MAX_NEW_TOKENS=2048
GENERATION_MAX_NEW_TOKENS=2048
CRITICAL_MAX_SAMPLES=128
PERSISTENT_POPULATION=critical

# Primary proxy is fixed before looking at outcomes. Other proxies are reported
# as exploratory consistency checks and do not enter a multiplicity gate.
PROXY_CONFIDENCE_EVALUATION=1
PROXY_CONFIDENCE_PRIMARY=generated_prefix16_negative_entropy
PROXY_CONFIDENCE_BOOTSTRAP_SAMPLES=2000
PROXY_CONFIDENCE_PERMUTATION_TESTS=2000

INTERVENTION_BOOTSTRAP_SAMPLES=2000
INTERVENTION_PERMUTATION_TESTS=2000
TASK_LABEL=mathqa_proxy_confidence_qwen3_4b
