# Frozen-module critical-sample intervention using the direct trust-region solver.
source configs/mathqa_external_semantic_continuous_v1.env

EXPERIMENT_PROFILE=mathqa_critical_content_direct
PAIR_SPECS="qwen3_4b:llama31_8b:16"
SUPPORTS="128"
MAX_SELECTED_MODULES=1
MAX_PER_SUPPORT=1

# Criticality is calibrated on causal_screen_a and applied unchanged to the
# independent style_confirmatory role.
CRITICAL_FRACTION=0.20
CRITICAL_CONTENT_WINDOW=32
CRITICAL_SURPRISAL_TOP_K=3
# The direct intervention is applied through step 31, so every selected
# critical decision is guaranteed to occur inside the intervention window.
CRITICAL_MAX_GENERATED_TOKEN_INDEX=31
CRITICAL_CONTROL_MAX_QUANTILE=0.50
CRITICAL_MAX_PAIRS=96
CRITICAL_MIN_PAIRS=48
CRITICAL_BASELINE_NEW_TOKENS=64

# Keep the successful intervention geometry unchanged.
GENERATION_PATCH_STEPS=32
GENERATION_MAX_NEW_TOKENS=2048
GENERATION_BATCH_SIZE=8
PERSISTENT_MAX_TRUNCATED_RATE=1.0
INTERVENTION_BOOTSTRAP_SAMPLES=3000
INTERVENTION_PERMUTATION_TESTS=3000
