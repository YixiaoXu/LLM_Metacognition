# Shared scientific contract for the 24-condition strict main experiment.
# Source a dataset configuration before this file.

SEED=42
MEASUREMENT_SEED=9327
ACTIVATION_CACHE_TAG=strict_chain_v2

LAYER_FRACS="0.46875 0.50 0.875"
TARGET_CACHE_LAYER_FRACS="$LAYER_FRACS"
SUPPORTS="32"
CANDIDATE_TOP_K=3072
NUM_MODULES=64
MODULE_MAX_MEMBERSHIPS=2
MAX_SELECTED_MODULES=16
MAX_PER_SUPPORT=16
STRICT_EXPECTED_FROZEN_MODULES=16

ADAPTIVE_EVIDENCE_SPLIT=selection
ALL_HELDOUT_MODULES=0
ADAPTIVE_FILL_TO_MAX=1
ADAPTIVE_MIN_RF=0.05
ADAPTIVE_MIN_GAIN_CI_LOW=-1.0
ADAPTIVE_MAX_SEMANTIC_R2=0.15
ADAPTIVE_SIZE_PENALTY=0.0

EXTERNAL_SEMANTIC_HEAD_TYPE=ensemble
EXTERNAL_SEMANTIC_HEAD_DEPTH=6
EXTERNAL_SEMANTIC_MAX_DIM=0
HIDDEN_DIM=1536
LATENT_DIM=384
MAIN_EPOCHS=180
MAIN_META_START=80
MAIN_DIRECTION_REFRESH_START=75
MAIN_DIRECTION_REFRESH_EVERY=5
MAIN_DIRECTION_FREEZE=120
MAIN_CHECKPOINT_START=90
SEMANTIC_ENCODER_WARMUP_EPOCHS=80
SEMANTIC_PROBE_EPOCHS=100
SEMANTIC_PROBE_HIDDEN_DIM=1024
MODULE_REFINER_EPOCHS=100
MODULE_REFINER_WORKERS=16

AXIS_TAIL_FRACTION=0.25
AXIS_PROTOTYPE_FRACTION=0.10
AXIS_CAUSAL_FRACTION=0.25
AXIS_ASSOCIATION_FRACTION=0.40
AXIS_TRAJECTORY_FRACTION=0.25
AXIS_SEMANTIC_FOLDS=5
AXIS_SEMANTIC_HIDDEN_DIM=512
AXIS_SEMANTIC_MLP_EPOCHS=80
AXIS_SEMANTIC_MLP_REPEATS=5

ASSOCIATION_EVALUATION_ROLE=association_confirmatory
PERSISTENT_EVALUATION_ROLE=trajectory_confirmatory
PROXY_CONFIDENCE_EVALUATION=0
META_BEHAVIOR_EVALUATION=0
STRICT_CHAIN_ALPHA=0.05

CONTINUOUS_DOSES="0.25 0.5 1.0"
CONTINUOUS_DIRECTION=0:1
CONTINUOUS_CONTROLS="opposite_direction random_hidden_direction"
REFINED_CODE_DOSE_MATCH_CONTROLS=1
PERSISTENT_POPULATION=critical
CRITICAL_MAX_SAMPLES=128
# The first 24-condition pass stops after every stages-1-2 passer completes
# next-token A/B. Three-ring passage is the conjunction of the three ring-level
# decisions, without an additional cross-module significance test.
# Resume with RUN_PERSISTENT_TRAJECTORY_OVERRIDE=1 to generate trajectories only
# for the frozen stages-1-2 passers.
RUN_PERSISTENT_TRAJECTORY=0
RUN_SINGLE_STEP_TRAJECTORY=0
# Freeze a 2,400-row ceiling, but generate only the first 1,600 rows initially.
# Historical compatible rows are filled first.  Add 400-row deterministic
# prefixes only when fewer than 1,300 untruncated rows remain for inference.
BASELINE_MAX_SAMPLES=2400
BASELINE_INITIAL_SAMPLES=1600
BASELINE_MIN_UNTRUNCATED_SAMPLES=1300
BASELINE_TOPUP_STEP=400
HISTORICAL_BASELINE_SEARCH_ROOTS="runs"
BASELINE_MAX_NEW_TOKENS=3072
GENERATION_MAX_NEW_TOKENS=3072
GENERATION_PATCH_STEPS=32
GENERATION_BATCH_SIZE=4
BASELINE_CLEAR_CUDA_CACHE_EVERY=4
BASELINE_OOM_RETRY_BATCH_SIZE=2
BASELINE_LOG_CUDA_MEMORY=0
PERSISTENT_MAX_TRUNCATED_RATE=0.50
INTERVENTION_BOOTSTRAP_SAMPLES=5000
INTERVENTION_PERMUTATION_TESTS=5000

SEMANTIC_ENSEMBLE_COMPONENTS_PER_REFERENCE=512
SEMANTIC_ENSEMBLE_PCA_FIT_ROWS=8192
SEMANTIC_ENSEMBLE_LAYER=0
TARGET_EXTRACTION_BATCH_SIZE=4
SEMANTIC_EXTRACTION_BATCH_SIZE=8
EXTRACTION_SHARD_SIZE=2048
MEMORY_EFFICIENT_EXTRACTION=1

DOWNSTREAM_AXIS_WORKERS_PER_GPU=8
DOWNSTREAM_AXIS_WORKER_GPU_MB=4000
DOWNSTREAM_AXIS_GPU_RESERVE_MB=8000
DOWNSTREAM_AXIS_CPU_THREADS_PER_WORKER=2
DOWNSTREAM_ASSOCIATION_WORKERS=8
DOWNSTREAM_ASSOCIATION_CPU_THREADS_PER_WORKER=4
DOWNSTREAM_ASSOCIATION_DEVICE=cuda:0
DOWNSTREAM_BASELINE_SHARDS=1
DOWNSTREAM_INTERVENTION_WORKERS_PER_GPU=1
DOWNSTREAM_INTERVENTION_WORKER_GPU_MB=15000
DOWNSTREAM_TRAJECTORY_WORKERS_PER_GPU=1
DOWNSTREAM_TRAJECTORY_WORKER_GPU_MB=15000
DOWNSTREAM_GPU_RESERVE_MB=0
LOG_PROGRESS_INTERVAL_SECONDS=60
GENERATION_PROGRESS_SECONDS=60
