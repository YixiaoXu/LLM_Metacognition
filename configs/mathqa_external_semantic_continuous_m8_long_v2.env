# MathQA generated-step, external-semantic, continuous-module experiment.
# Runtime values such as GPU ids, RUN_ROOT and FORCE are supplied by the
# launcher.  This configuration follows the current long-run contract while
# removing Qwen2.5-Math because of its high truncation rate.

BASE_CONFIG_FILE=configs/mathqa_external_semantic_continuous_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=mathqa_external_semantic_continuous_m8_long_v2
DATASET_PROFILE=mathqa
SEED=42
MEASUREMENT_SEED=42017

DATA_SOURCE=mathqa
DATA_PREPARED_PATH=data/mathqa_chat_resplit_s42
BASE_DATA_PATH=data/mathqa_chat_resplit_s42/all.jsonl
DATA_SPLIT_MODE=resplit
DATA_TRAIN_SIZE=22000
DATA_VALIDATION_SIZE=7000

# Qwen2.5-Math is intentionally excluded.  All pairs use explicit semantic
# reference layers and no target model is used as its own semantic reference.
PAIR_SPECS="llama31_8b:qwen3_8b:18 qwen3_8b:llama31_8b:16 deepseek_llama8b:qwen3_8b:18 qwen3_4b:llama31_8b:16 llama2_7b:qwen3_4b:18 llama32_3b:qwen25_7b:14 qwen25_7b:llama31_8b:16 deepseek_qwen7b:llama31_8b:16"

# MathQA prompts and reasoning traces need a larger context than the safety
# dataset, while the generation/intervention contract remains 2048 tokens.
TARGET_PROMPT_MAX_SAMPLES=8000
GENERATION_RECORD_STEPS="0,4,8,12,16,20"
MAX_GENERATION_STEPS=21
EXTRACTION_MAX_LENGTH=4096
EXTERNAL_SEMANTIC_MAX_LENGTH=4096
EXTRACTION_SHARD_SIZE=2048
MEMORY_EFFICIENT_EXTRACTION=1
TARGET_EXTRACTION_BATCH_SIZE=4
SEMANTIC_EXTRACTION_BATCH_SIZE=8
CHAT_TEMPLATE_ENABLE_THINKING=auto

LAYER_FRACS="0.46875 0.50 0.875"
SEMANTIC_ANCHOR_OFFSETS="1"
SPLIT_BY_BASE_ID=1
BASE_ID_STEP_PATTERN="::step\\d+$"

LATENT_DIM=256
HIDDEN_DIM=1024
TRAIN_DROPOUT=0.05
TRAIN_BATCH_SIZE=512
ENCODE_BATCH_SIZE=1024
MAIN_EPOCHS=120
MAIN_DIRECTION_FREEZE=65
MAIN_CHECKPOINT_START=65
TRAIN_LR=0.0001
TRAIN_WEIGHT_DECAY=0.0001
VAL_RATIO=0.25
TEST_RATIO=0.25

SUPPORTS="128"
CANDIDATE_TOP_K=1024
NUM_MODULES=8
MAX_SELECTED_MODULES=6
MAX_PER_SUPPORT=6
MODULE_MAX_MEMBERSHIPS=2
MODULE_CODE_DIM=8
CANDIDATE_MIN_RATE=0.04
CANDIDATE_MAX_RATE=0.96
CANDIDATE_MAX_RATE_DRIFT=0.10
BINARY_QUANTILE=0.75

EXTERNAL_SEMANTIC_MAX_DIM=0
EXTERNAL_SEMANTIC_RIDGE=1.0
MAIN_META_START=20
MAIN_DIRECTION_REFRESH_START=15
MAIN_DIRECTION_REFRESH_EVERY=5
DIRECTION_RIDGE=0.02
DIRECTION_SEMANTIC_PENALTY=5.0
DIRECTION_EMA=0.60
DIRECTION_MAX_SAMPLES=8192
DIRECTION_MIN_COSINE=0.45
SEMANTIC_ENCODER_WARMUP_EPOCHS=30
SEMANTIC_PROBE_EPOCHS=30
SEMANTIC_PROBE_HIDDEN_DIM=512
SEMANTIC_PROBE_LR=0.001
SEMANTIC_PROBE_WEIGHT_DECAY=0.0001
MODULE_REFINER_EPOCHS=80
MODULE_REFINER_HIDDEN_DIM=192
MODULE_REFINER_LR=0.0003

LAMBDA_NEXT=1.0
LAMBDA_PREV=1.0
LAMBDA_ORTH=0.10
LAMBDA_E2_PREV_COV=0.20
LAMBDA_SEMANTIC_CANDIDATE=0.20
LAMBDA_SEMANTIC_MODULE=0.20
LAMBDA_RESIDUAL_MODULE=0.25
LAMBDA_JOINT_MODULE=0.10
LAMBDA_VAR=0.01
CHECKPOINT_RESIDUAL_GAIN_WEIGHT=1.0
CHECKPOINT_TOTAL_GAIN_WEIGHT=0.02
CHECKPOINT_RF_WEIGHT=0.20
CHECKPOINT_POSITIVE_MODULE_WEIGHT=0.002
MODULE_SELECTION_RESIDUAL_GAIN_WEIGHT=1.0
MODULE_SELECTION_TOTAL_GAIN_WEIGHT=0.02
MODULE_SELECTION_RF_WEIGHT=0.40
MODULE_SELECTION_CONTINUOUS_SEMANTIC_R2_PENALTY=0.50
MODULE_SELECTION_MAX_CONTINUOUS_SEMANTIC_R2=1.0
BOOTSTRAP_SAMPLES=1000
PERMUTATION_TESTS=2000

ADAPTIVE_MIN_RF=0.03
ADAPTIVE_MIN_GAIN_CI_LOW=-0.005
ADAPTIVE_MAX_SEMANTIC_R2=0.75
ADAPTIVE_SIZE_PENALTY=0.01

AXIS_TAIL_FRACTION=0.25
AXIS_PROTOTYPE_FRACTION=0.10
AXIS_CAUSAL_FRACTION=0.30
AXIS_SEMANTIC_FOLDS=5
AXIS_SEMANTIC_HIDDEN_DIM=128
AXIS_SEMANTIC_MLP_EPOCHS=16
AXIS_SEMANTIC_MLP_REPEATS=2

DIRECT_TRUST_REGION_STEPS=20
DIRECT_TRUST_REGION_STEP_SCALE=1.25
DIRECT_TRUST_REGION_HIDDEN_PENALTY=0.10

METRIC_PROFILE=math
ANSWER_EXTRACTION=mathqa_choice
DOWNSTREAM_USE_CHAT_TEMPLATE=0
DOWNSTREAM_MAX_LENGTH=4096
EVALUATION_ID_REGEX="::step000$"

CONTINUOUS_DOSES="0.25 0.5 1.0"
CONTINUOUS_DIRECTION=0:1
MAX_HIDDEN_REL_NORM=0.03
MAX_SEMANTIC_REL_DELTA=0.05
REFINED_CODE_SEMANTIC_PENALTY=1.0
REFINED_CODE_Z1_PENALTY=1.0
GENERATION_PATCH_STEPS=32
GENERATION_BATCH_SIZE=8
GENERATION_MAX_NEW_TOKENS=2048

PERSISTENT_MAX_TRUNCATED_RATE=1.0
BASELINE_MAX_SAMPLES=1200
BASELINE_MAX_NEW_TOKENS=2048
NEXT_TOKEN_TOP_K=16
NEXT_TOKEN_AUTO_LOGIT_TOP_K=64
NEXT_TOKEN_AUTO_MIN_MEAN_PROB=0.0001
NEXT_TOKEN_AUTO_MIN_SELECTED=16
CRITICAL_FRACTIONS="0.10 0.20 0.30 0.40"
CRITICAL_MAX_SAMPLES=96
CRITICAL_WEIGHTS="0.55 0.45 0.0"
PERSISTENT_POPULATION=critical
PERSISTENT_EVALUATION_ROLE=trajectory_confirmatory
INTERVENTION_BOOTSTRAP_SAMPLES=3000
INTERVENTION_PERMUTATION_TESTS=3000
MODULE_BEHAVIOR_ALPHA=0.05
TASK_LABEL=mathqa_external_semantic_continuous_m8_long_v2
TRUST_REMOTE_CODE=1
