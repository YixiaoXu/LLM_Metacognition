# Supplementary layer-topology experiment.  The launcher overrides
# PAIR_SPECS and LAYER_FRACS for each pre-registered topology.
BASE_CONFIG_FILE=configs/ultrachat_external_semantic_continuous_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_layer_topology_supplement_v1
PAIR_SPECS="llama32_3b:qwen3_0p6b:14"

# Same target model, external semantic family, prompts and generated steps.
TARGET_PROMPT_MAX_SAMPLES=10000
GENERATION_RECORD_STEPS="0,4,8,12,16,20"
MAX_GENERATION_STEPS=21
EXTRACTION_MAX_LENGTH=2048
EXTERNAL_SEMANTIC_MAX_LENGTH=2048
TARGET_EXTRACTION_BATCH_SIZE=8
SEMANTIC_EXTRACTION_BATCH_SIZE=8
MEMORY_EFFICIENT_EXTRACTION=1

# One support and a fixed number of exported modules keep the layer sweep
# focused on topology rather than support-size selection.
SUPPORTS="128"
EXTERNAL_SEMANTIC_HEAD_TYPE=mlp
EXTERNAL_SEMANTIC_HEAD_DEPTH=4
NUM_MODULES=8
MAX_SELECTED_MODULES=4
MAX_PER_SUPPORT=4
MAIN_EPOCHS=100
MAIN_DIRECTION_FREEZE=55
MAIN_CHECKPOINT_START=55

# Keep all expensive downstream stages identical across layer conditions.
BASELINE_MAX_SAMPLES=800
BASELINE_MAX_NEW_TOKENS=1024
GENERATION_MAX_NEW_TOKENS=1024
GENERATION_BATCH_SIZE=8
PERSISTENT_MAX_TRUNCATED_RATE=1.0
AXIS_PROTOTYPE_FRACTION=0.15
AXIS_CAUSAL_FRACTION=0.40
CRITICAL_MAX_SAMPLES=64
INTERVENTION_BOOTSTRAP_SAMPLES=1000
INTERVENTION_PERMUTATION_TESTS=1000

# Default is overwritten per topology. Fractions resolve to a 28-layer
# Llama-3.2 target triplet and the matching middle layer in Qwen3-0.6B.
LAYER_FRACS="0.46875 0.50 0.875"
TASK_LABEL=ultrachat_layer_topology_supplement
