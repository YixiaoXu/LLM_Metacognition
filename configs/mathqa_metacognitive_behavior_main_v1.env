# Main metacognitive-behavior analysis on the completed MathQA run.
BASE_CONFIG_FILE=configs/mathqa_external_semantic_continuous_m8_long_v2.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=mathqa_metacognitive_behavior_main_v1
META_BEHAVIOR_EVALUATION=1
META_BEHAVIOR_EXCLUDE_TRUNCATED=1
META_BEHAVIOR_BOOTSTRAP_SAMPLES=2000
META_BEHAVIOR_PERMUTATION_TESTS=2000
META_BEHAVIOR_INCLUDE_SECONDARY=1
TASK_LABEL=mathqa_metacognitive_behavior_main_v1
