# UltraChat multi-model confirmatory run with longer uncensored generations.
# This file intentionally repeats all scientific overrides so the effective
# experiment does not depend on variables inherited from the launch shell.

BASE_CONFIG_FILE=configs/ultrachat_external_semantic_continuous_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_external_semantic_continuous_m4_long_v2

# Format: target_profile:external_semantic_profile:semantic_layer.
PAIR_SPECS="llama2_7b:qwen3_4b:18 llama31_8b:qwen3_8b:18 llama32_3b:qwen25_7b:14 qwen25_7b:llama31_8b:16 qwen25_math7b:llama31_8b:16 qwen3_4b:llama31_8b:16 qwen3_8b:llama31_8b:16 deepseek_llama8b:qwen3_4b:18 deepseek_qwen7b:llama31_8b:16"

# Explicitly restore both support sizes. Four modules are discovered at each
# support, while only the two strongest held-out modules enter costly generation.
SUPPORTS="64 128"
NUM_MODULES=4
MAX_SELECTED_MODULES=2
MAX_PER_SUPPORT=2

# Both observed runs were still improving near epoch 100. The held-out
# checkpoint remains authoritative, so extra epochs add search room rather than
# forcing the final epoch to be used.
MAIN_EPOCHS=120
MAIN_DIRECTION_FREEZE=65
MAIN_CHECKPOINT_START=65

# Give more independent prompts to conditional behavior analysis. With 2,500
# held-out base prompts this allocates about 250 prototype, 375+375 causal,
# 750 association, and 750 trajectory prompts.
AXIS_PROTOTYPE_FRACTION=0.10
AXIS_CAUSAL_FRACTION=0.30
BASELINE_MAX_SAMPLES=1200

# The previous 768-token run truncated roughly 40% of Llama-2 responses.
# 2,048 also fits Llama-2's 4,096-token context after the 2,048-token prompt cap.
BASELINE_MAX_NEW_TOKENS=2048
GENERATION_MAX_NEW_TOKENS=2048
# Truncated rows are excluded from style tests, but one unusually verbose model
# must not abort the other model queues. The observed rate remains in summaries.
PERSISTENT_MAX_TRUNCATED_RATE=1.0

# Preserve the memory-efficient extractor introduced after the first launch.
MEMORY_EFFICIENT_EXTRACTION=1
TARGET_EXTRACTION_BATCH_SIZE=4
SEMANTIC_EXTRACTION_BATCH_SIZE=8

TASK_LABEL=ultrachat_multistep_external_semantic_m4_long_v2
