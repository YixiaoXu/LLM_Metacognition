# Shared scientific contract for the complete main/ablation rerun.
# Dataset-specific configs source this file after their long-run base config.

SUPPORTS="32"
CANDIDATE_TOP_K=1024
NUM_MODULES=8
MAX_SELECTED_MODULES=6
MAX_PER_SUPPORT=6

# The MLP condition is the common reference for every ablation. Sweep tasks
# override these two fields through the cleaned generated-step launcher.
EXTERNAL_SEMANTIC_HEAD_TYPE=mlp
EXTERNAL_SEMANTIC_HEAD_DEPTH=2

# Keep training and downstream inference aligned across the three datasets.
MAIN_EPOCHS=120
MAIN_DIRECTION_FREEZE=65
MAIN_CHECKPOINT_START=65
CONTINUOUS_DOSES="0.25 0.5 1.0"
PERSISTENT_MAX_TRUNCATED_RATE=1.0

# Causal-ablation defaults. The master queue enables the expensive matched
# single-step trajectory and random controls only for pre-registered tasks.
RUN_SINGLE_STEP_TRAJECTORY=0
MODULE_DIRECTION_MODE=learned
RANDOM_SUPPORT_NULL=0
RANDOM_SUPPORT_SEED=777
CONTINUOUS_CONTROLS="opposite_direction"
REFINED_CODE_DOSE_MATCH_CONTROLS=0
RANDOM_HIDDEN_CANDIDATES=8

# Include the second-order confidence/uncertainty readouts in every full run.
META_BEHAVIOR_EVALUATION=1
META_BEHAVIOR_EXCLUDE_TRUNCATED=1
META_BEHAVIOR_BOOTSTRAP_SAMPLES=2000
META_BEHAVIOR_PERMUTATION_TESTS=2000
META_BEHAVIOR_INCLUDE_SECONDARY=1
