# Strict single-pair adjudication experiment.
# Target: DeepSeek-R1-Distill-Qwen-7B; domain: MathQA.
# Semantic reference features are assembled separately from three frozen LLMs.

BASE_CONFIG_FILE=configs/mathqa_external_semantic_continuous_m8_long_v2.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=mathqa_strict_chain_deepseek_qwen7b_v1
TASK_LABEL=mathqa_strict_chain_deepseek_qwen7b_v1
SEED=42
MEASUREMENT_SEED=9327

TARGET_PROFILE=deepseek_qwen7b
TARGET_PROMPT_MAX_SAMPLES=28000
DATA_MAX_SAMPLES=0
DATA_TRAIN_SIZE=22000
DATA_VALIDATION_SIZE=7000
ACTIVATION_CACHE_TAG=strict_chain_v1

# Keep the finalized main-experiment topology and support fixed.  The new
# search dimension is the number of modules, not support size or layer choice.
LAYER_FRACS="0.46875 0.50 0.875"
TARGET_CACHE_LAYER_FRACS="$LAYER_FRACS"
SUPPORTS="32"
CANDIDATE_TOP_K=3072
NUM_MODULES=64
MODULE_MAX_MEMBERSHIPS=2
MAX_SELECTED_MODULES=16
MAX_PER_SUPPORT=16

# Rank modules on the selection split.  Held-out rows remain untouched until
# transmission, association and intervention evaluation.
ADAPTIVE_EVIDENCE_SPLIT=selection
ALL_HELDOUT_MODULES=0
ADAPTIVE_MIN_RF=0.05
ADAPTIVE_MIN_GAIN_CI_LOW=-1.0
ADAPTIVE_MAX_SEMANTIC_R2=0.15
ADAPTIVE_SIZE_PENALTY=0.0

# Stronger semantic fitting.  The ensemble cache is already train-only PCA
# standardized; this head adds linear, MLP and deep-residual branches.
EXTERNAL_SEMANTIC_HEAD_TYPE=ensemble
EXTERNAL_SEMANTIC_HEAD_DEPTH=6
EXTERNAL_SEMANTIC_MAX_DIM=0
HIDDEN_DIM=1536
LATENT_DIM=384
MAIN_EPOCHS=180
MAIN_META_START=80
MAIN_DIRECTION_REFRESH_START=75
MAIN_DIRECTION_REFRESH_EVERY=5
MAIN_DIRECTION_FREEZE=120
MAIN_CHECKPOINT_START=90
SEMANTIC_ENCODER_WARMUP_EPOCHS=80
SEMANTIC_PROBE_EPOCHS=100
SEMANTIC_PROBE_HIDDEN_DIM=1024
MODULE_REFINER_EPOCHS=100
MODULE_REFINER_WORKERS=16

# Staged downstream scheduler.  Axis/probe jobs are light; full intervention
# jobs load one complete target model.  Measurements from this exact target
# show approximately 15 GB per full downstream worker, so scheduling uses that
# observed footprint without an additional idle-memory reserve.
# The strict run exports at most 16 axes.  One lightweight probe process per
# selected module fills both 72 GB GPUs in a single wave; the scheduler still
# derives the actual slot count from current free memory.
DOWNSTREAM_AXIS_WORKERS_PER_GPU=8
DOWNSTREAM_AXIS_WORKER_GPU_MB=4000
DOWNSTREAM_AXIS_GPU_RESERVE_MB=8000
DOWNSTREAM_AXIS_CPU_THREADS_PER_WORKER=2
DOWNSTREAM_ASSOCIATION_WORKERS=8
DOWNSTREAM_ASSOCIATION_CPU_THREADS_PER_WORKER=4
DOWNSTREAM_ASSOCIATION_DEVICE=cuda:0
DOWNSTREAM_BASELINE_SHARDS=2
# Full intervention is intentionally serialized per GPU to avoid transient
# memory spikes during model loading and long-generation decoding.
DOWNSTREAM_INTERVENTION_WORKERS_PER_GPU=1
DOWNSTREAM_INTERVENTION_WORKER_GPU_MB=15000
# Keep full critical-sample generation conservative even if next-token screen
# concurrency is increased in a later experiment.
DOWNSTREAM_TRAJECTORY_WORKERS_PER_GPU=1
DOWNSTREAM_TRAJECTORY_WORKER_GPU_MB=15000
DOWNSTREAM_GPU_RESERVE_MB=0

# Strong held-out semantic readout used by each frozen continuous axis.
AXIS_SEMANTIC_FOLDS=5
AXIS_SEMANTIC_HIDDEN_DIM=512
AXIS_SEMANTIC_MLP_EPOCHS=80
AXIS_SEMANTIC_MLP_REPEATS=5

# Independent downstream roles.  The same frozen module id flows through all
# stages; no downstream outcome is used to retrain or reorient the module.
ASSOCIATION_EVALUATION_ROLE=association_confirmatory
PERSISTENT_EVALUATION_ROLE=trajectory_confirmatory
PROXY_CONFIDENCE_EVALUATION=1
PROXY_CONFIDENCE_PRIMARY=generated_prefix16_negative_entropy
PROXY_CONFIDENCE_BOOTSTRAP_SAMPLES=5000
PROXY_CONFIDENCE_PERMUTATION_TESTS=5000
META_BEHAVIOR_EVALUATION=1
META_BEHAVIOR_INCLUDE_SECONDARY=1
META_BEHAVIOR_BOOTSTRAP_SAMPLES=5000
META_BEHAVIOR_PERMUTATION_TESTS=5000
MODULE_BEHAVIOR_ALPHA=0.05

CONTINUOUS_DOSES="0.25 0.5 1.0"
CONTINUOUS_DIRECTION=0:1
CONTINUOUS_CONTROLS="opposite_direction random_hidden_direction"
REFINED_CODE_DOSE_MATCH_CONTROLS=1
# Full trajectories are a focused follow-up to the independent transmission,
# association and next-token screens. Select a small population using only
# pre-intervention next-token uncertainty (top-2 gap and entropy);
# post-treatment argmax changes remain available as descriptive cases but do
# not define the persistent-generation population.
PERSISTENT_POPULATION=critical
CRITICAL_MAX_SAMPLES=128
RUN_PERSISTENT_TRAJECTORY=1
RUN_SINGLE_STEP_TRAJECTORY=0
BASELINE_MAX_SAMPLES=2400
BASELINE_MAX_NEW_TOKENS=3072
GENERATION_MAX_NEW_TOKENS=3072
GENERATION_PATCH_STEPS=32
GENERATION_BATCH_SIZE=4
LOG_PROGRESS_INTERVAL_SECONDS=60
GENERATION_PROGRESS_SECONDS=60
PERSISTENT_MAX_TRUNCATED_RATE=0.50
INTERVENTION_BOOTSTRAP_SAMPLES=5000
INTERVENTION_PERMUTATION_TESTS=5000

# Three heterogeneous references and their established middle layers.
SEMANTIC_REFERENCE_SPECS="llama31_8b:16 qwen3_8b:18 qwen25_7b:14"
SEMANTIC_ENSEMBLE_COMPONENTS_PER_REFERENCE=512
SEMANTIC_ENSEMBLE_PCA_FIT_ROWS=8192
SEMANTIC_ENSEMBLE_LAYER=0

TARGET_EXTRACTION_BATCH_SIZE=4
SEMANTIC_EXTRACTION_BATCH_SIZE=8
EXTRACTION_SHARD_SIZE=2048
MEMORY_EFFICIENT_EXTRACTION=1
