# Main metacognitive-behavior analysis on the completed UltraChat run.
# Upstream decoupling/module artifacts are reused; this overlay only enables
# confidence/uncertainty recording and analysis.
BASE_CONFIG_FILE=configs/ultrachat_external_semantic_continuous_m4_long_v2.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_metacognitive_behavior_main_v1
META_BEHAVIOR_EVALUATION=1
META_BEHAVIOR_EXCLUDE_TRUNCATED=1
META_BEHAVIOR_BOOTSTRAP_SAMPLES=2000
META_BEHAVIOR_PERMUTATION_TESTS=2000
META_BEHAVIOR_INCLUDE_SECONDARY=1
TASK_LABEL=ultrachat_metacognitive_behavior_main_v1
