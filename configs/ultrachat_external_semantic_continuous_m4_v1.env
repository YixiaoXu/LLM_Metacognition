# Nine-target UltraChat experiment with four discovered modules per support.
# The inherited file contains the versioned scientific defaults. Both files and
# their SHA-256 checksums are snapshotted into each run directory.

BASE_CONFIG_FILE=configs/ultrachat_external_semantic_continuous_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_external_semantic_continuous_m4_v1

# Format: target_profile:external_semantic_profile:semantic_layer.
# Target profiles are unique so two workers never write the same activation cache.
PAIR_SPECS="llama2_7b:qwen3_4b:18 llama31_8b:qwen3_8b:18 llama32_3b:qwen25_7b:14 qwen25_7b:llama31_8b:16 qwen25_math7b:llama31_8b:16 qwen3_4b:llama31_8b:16 qwen3_8b:llama31_8b:16 deepseek_llama8b:qwen3_4b:18 deepseek_qwen7b:llama31_8b:16"

# Four modules are optimized for each support. At most four independently
# selected modules continue to the expensive baseline/intervention stages.
NUM_MODULES=4
MAX_SELECTED_MODULES=4
MAX_PER_SUPPORT=2
