# UltraChat generated-step experiment for newly downloaded model scales.
# Qwen3-4B is used only as the common external semantic reference.

BASE_CONFIG_FILE=configs/ultrachat_external_semantic_continuous_v1.env
source "$BASE_CONFIG_FILE"

EXPERIMENT_PROFILE=ultrachat_external_semantic_new_models_v1
TASK_LABEL=ultrachat_external_semantic_new_models_v1

# Do not repeat Qwen3-4B or Qwen3-8B as target models.  All targets use the
# same small, already available Qwen3-4B semantic reference at layer 16.
PAIR_SPECS="qwen3_0p6b:qwen3_4b:16 qwen3_1p7b:qwen3_4b:16 qwen3_14b:qwen3_4b:16 qwen3_32b:qwen3_4b:16 gemma3_1b_it:qwen3_4b:16 gemma3_4b_it:qwen3_4b:16 gemma3_12b_it:qwen3_4b:16"

# Keep the current UltraChat long-run data and multi-step contract.
TARGET_PROMPT_MAX_SAMPLES=10000
GENERATION_RECORD_STEPS="0,4,8,12,16,20"
MAX_GENERATION_STEPS=21
EXTRACTION_MAX_LENGTH=2048
EXTERNAL_SEMANTIC_MAX_LENGTH=2048
EXTRACTION_SHARD_SIZE=2048
MEMORY_EFFICIENT_EXTRACTION=1
CHAT_TEMPLATE_ENABLE_THINKING=auto

# Keep the latest module-search setting used for the larger UltraChat run.
SUPPORTS="128"
CANDIDATE_TOP_K=1024
NUM_MODULES=8
MAX_SELECTED_MODULES=6
MAX_PER_SUPPORT=6

# Training/probe throughput is unchanged.  Only target-model inference and
# generated-step activation extraction are conservative to protect 14B/32B.
TRAIN_BATCH_SIZE=512
ENCODE_BATCH_SIZE=1024
TARGET_EXTRACTION_BATCH_SIZE=1
SEMANTIC_EXTRACTION_BATCH_SIZE=8
GENERATION_BATCH_SIZE=1

MAIN_EPOCHS=120
MAIN_DIRECTION_FREEZE=65
MAIN_CHECKPOINT_START=65
SEMANTIC_ENCODER_WARMUP_EPOCHS=30
SEMANTIC_PROBE_EPOCHS=30
MODULE_REFINER_EPOCHS=80

# The external semantic reference is intentionally fixed across all targets.
EXTERNAL_SEMANTIC_MAX_DIM=0
EXTERNAL_SEMANTIC_RIDGE=1.0

# Long-generation baseline and continuous intervention settings.
BASELINE_MAX_SAMPLES=1200
BASELINE_MAX_NEW_TOKENS=2048
GENERATION_MAX_NEW_TOKENS=2048
DOWNSTREAM_MAX_LENGTH=2048
GENERATION_PATCH_STEPS=32
PERSISTENT_MAX_TRUNCATED_RATE=1.0
PERSISTENT_POPULATION=critical
PERSISTENT_EVALUATION_ROLE=trajectory_confirmatory

CONTINUOUS_DOSES="0.25 0.5 1.0"
CONTINUOUS_DIRECTION=0:1
MAX_HIDDEN_REL_NORM=0.03
MAX_SEMANTIC_REL_DELTA=0.05

METRIC_PROFILE=conversation
ANSWER_EXTRACTION=none
DOWNSTREAM_USE_CHAT_TEMPLATE=0
TRUST_REMOTE_CODE=1
